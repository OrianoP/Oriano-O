# Address of the POS (oriano-pos-v4), e.g. https://pos.orianopizza.com
POS_API_URL=
# Must be IDENTICAL to ONLINE_ORDERS_SECRET on the POS. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONLINE_ORDERS_SECRET=
# Public address of this site (used for SEO links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://order.orianopizza.com
# Optional
NEXT_PUBLIC_INSTAGRAM_URL=
# Optional Cloudflare Turnstile (free bot check at checkout). Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
